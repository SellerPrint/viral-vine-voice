# ViralDub — variables d'environnement
#
# En local  : copier ce fichier en `.dev.vars` (déjà dans .gitignore)
# En prod   : configurer via `wrangler secret put <NOM>` ou le dashboard Cloudflare
#
# ⚠️ Ne jamais committer les vraies valeurs.

# ─── Requis ──────────────────────────────────────────────────────────────
# ElevenLabs — transcription (Scribe v2) + synthèse vocale (Turbo v2.5)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Gateway IA — traduction via Gemini 2.5 Flash
LOVABLE_API_KEY=

# ─── Optionnel ───────────────────────────────────────────────────────────
# ai33.pro — voix clonée (API compatible OpenAI /v1/audio/speech)
# Nécessaire uniquement si le provider TTS "ai33" est sélectionné dans l'UI
AI33_API_KEY=

# Cloudflare Turnstile — protection anti-abus des endpoints IA
# Fortement recommandé avant tout déploiement public (cf. AUDIT.md §2.1)
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
